{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "benyaminrmb/laravel-dynamic-resources",
  "description": "Composable, IDE-discoverable API resource views and safe sparse fieldsets for Laravel.",
  "keywords": [
    "api",
    "dynamic",
    "json",
    "laravel",
    "resources",
    "sparse-fieldsets"
  ],
  "homepage": "https://github.com/Benyaminrmb/laravel-dynamic-resources",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Benyamin Rmb",
      "email": "benyaminrmb@gmail.com"
    }
  ],
  "support": {
    "issues": "https://github.com/Benyaminrmb/laravel-dynamic-resources/issues",
    "source": "https://github.com/Benyaminrmb/laravel-dynamic-resources"
  },
  "require": {
    "php": "^8.3",
    "illuminate/console": "^12.0|^13.0",
    "illuminate/filesystem": "^12.0|^13.0",
    "illuminate/http": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0",
    "symfony/http-kernel": "^7.2|^8.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.0",
    "laravel/pint": "^1.27",
    "orchestra/testbench": "^10.0|^11.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Benyaminrmb\\LaravelDynamicResources\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Benyaminrmb\\LaravelDynamicResources\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "analyse": "vendor/bin/phpstan analyse --memory-limit=512M",
    "check": [
      "@composer:validate",
      "@format:check",
      "@analyse",
      "@test"
    ],
    "format": "vendor/bin/pint",
    "format:check": "vendor/bin/pint --test",
    "test": "vendor/bin/pest",
    "test:coverage": "@php -d xdebug.mode=coverage vendor/bin/pest --coverage --min=80",
    "composer:validate": "composer validate --strict --no-check-publish"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Benyaminrmb\\LaravelDynamicResources\\Providers\\DynamicResourceServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
